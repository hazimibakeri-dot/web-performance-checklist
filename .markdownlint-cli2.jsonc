{
  // https://github.com/DavidAnson/markdownlint/blob/main/doc/Rules.md
  "config": {
    "default": true,
    // Prose is wrapped by hand; long URLs and tables cannot be wrapped.
    "MD013": false,
    // Allow repeated headings such as "Examples" in different sections.
    "MD024": { "siblings_only": true },
    // Checklist items continue on indented lines.
    "MD007": { "indent": 2 },
    // Tables use compact pipe style.
    "MD060": false
  },
  "globs": ["**/*.md"],
  "ignores": ["node_modules/**"]
}
